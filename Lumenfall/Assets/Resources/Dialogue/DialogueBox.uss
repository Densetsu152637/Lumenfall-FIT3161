/* Dialogue box, laid out against a 1920x1080 reference and scaled with screen height. */

.dialogue-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dialogue-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 14, 24, 0.3);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.dialogue-root--shown .dialogue-dim {
    opacity: 1;
}

.dialogue-box {
    position: absolute;
    left: 50%;
    bottom: 26px;
    width: 1260px;
    height: 420px;
    max-width: 96%;
    translate: -50% 48px;
    opacity: 0;
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: opacity, translate, width, height;
    transition-duration: 0.22s, 0.32s, 0.2s, 0.2s;
    transition-timing-function: ease-out, ease-out-back, ease-out, ease-out;
}

.dialogue-root--shown .dialogue-box {
    translate: -50% 0;
    opacity: 1;
}

/* Neutral NPC dialogue fills the complete lower screen edge. Its decorative caps remain fixed while only the
   deliberately plain middle strip expands, so no painted detail is distorted on wide displays. */
.dialogue-box--stretch {
    left: 0;
    right: 0;
    bottom: 0;
    width: auto;
    max-width: none;
    height: 360px;
    translate: 0 48px;
    background-image: none;
}

.dialogue-root--shown .dialogue-box--stretch {
    translate: 0 0;
}

.dialogue-stretch-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.dialogue-box--stretch .dialogue-stretch-frame {
    display: flex;
}

.dialogue-stretch-frame__left,
.dialogue-stretch-frame__middle,
.dialogue-stretch-frame__right {
    position: absolute;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.dialogue-stretch-frame__left {
    left: 0;
    width: 219px;
}

.dialogue-stretch-frame__middle {
    left: 217px;
    right: 291px;
}

.dialogue-stretch-frame__right {
    right: 0;
    width: 293px;
}

.dialogue-box--stretch .dialogue-content {
    left: 400px;
    right: 240px;
    top: 114px;
    bottom: 92px;
    width: auto;
    height: auto;
}

.dialogue-box--stretch .dialogue-ribbon {
    left: 190px;
    top: 10px;
}

.dialogue-box--stretch.dialogue-box--portrait .dialogue-ribbon {
    left: 352px;
}

.dialogue-box--stretch .dialogue-portrait {
    left: 117px;
    top: 30px;
    width: 248px;
    height: 248px;
    border-radius: 124px;
    border-width: 9px;
}

.dialogue-box--stretch .dialogue-continue {
    right: 330px;
    bottom: 88px;
}

/* Live portrait, sitting over the frame's top-left corner. */
.dialogue-portrait {
    position: absolute;
    left: 54px;
    top: -146px;
    width: 216px;
    height: 216px;
    border-radius: 108px;
    border-width: 7px;
    border-color: rgb(120, 90, 60);
    background-color: rgb(244, 233, 210);
    -unity-background-scale-mode: scale-and-crop;
    display: none;
}

.dialogue-box--portrait .dialogue-portrait {
    display: flex;
}

/* Name ribbon on the frame's top edge, coloured per speaker. */
.dialogue-ribbon {
    position: absolute;
    left: 180px;
    top: -26px;
    padding: 8px 34px 10px 30px;
    border-radius: 8px;
    border-bottom-width: 4px;
    border-color: rgba(0, 0, 0, 0.25);
    background-color: rgb(80, 72, 90);
}

.dialogue-box--portrait .dialogue-ribbon {
    left: 286px;
}

.dialogue-name {
    font-size: 30px;
    color: rgb(255, 250, 240);
    -unity-text-outline-width: 0.15px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.35);
}

/* The parchment area inside the painted frame. */
.dialogue-content {
    position: absolute;
    left: 17%;
    top: 21%;
    width: 66%;
    height: 57%;
    overflow: hidden;
}

.dialogue-content .unity-scroller--vertical {
    width: 18px;
    margin-left: 10px;
}

.dialogue-content .unity-base-slider__tracker {
    background-color: rgba(120, 90, 50, 0.18);
    border-radius: 8px;
}

.dialogue-content .unity-base-slider__dragger {
    background-color: rgba(120, 90, 50, 0.72);
    border-radius: 8px;
}

.dialogue-text {
    font-size: 30px;
    white-space: normal;
    color: rgb(28, 24, 38);
    -unity-text-align: upper-left;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

/* Rows keep their full height; the box is sized to fit them rather than squeezing them together. */
.dialogue-choices {
    margin-top: 10px;
    flex-shrink: 0;
}

.dialogue-choice {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    flex-shrink: 0;
    margin-top: 6px;
    margin-right: 54px;
    padding: 5px 14px 5px 8px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(120, 90, 50, 0.3);
    background-color: rgba(255, 249, 234, 0.7);
    transition-property: translate, background-color, border-color;
    transition-duration: 0.12s;
}

.dialogue-choice--selected {
    translate: 8px 0;
    background-color: rgba(255, 238, 196, 0.98);
}

.dialogue-choice__arrow {
    width: 18px;
    height: 20px;
    margin-right: 8px;
    opacity: 0;
}

.dialogue-choice--selected .dialogue-choice__arrow {
    opacity: 1;
}

.dialogue-choice__text {
    font-size: 27px;
    color: rgb(28, 24, 38);
    white-space: normal;
    flex-shrink: 1;
    padding: 0;
    margin: 0;
}

/* Invisible copies of the page and its choices, one per box size, measured to pick the box size. */
.dialogue-sizer {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
}

/* "Press to continue" arrow in the frame's lower-right. */
.dialogue-continue {
    position: absolute;
    right: 16%;
    bottom: 22%;
    width: 32px;
    height: 24px;
    display: none;
}

.dialogue-box--waiting .dialogue-continue {
    display: flex;
}

/* Shared accessibility preferences retain the authored layout and make overflow reachable. */
.dialogue-text, .dialogue-choices, .dialogue-choice { flex-shrink: 0; }
.dialogue-high-contrast .dialogue-box { background-color: black; }
.dialogue-high-contrast .dialogue-text,
.dialogue-high-contrast .dialogue-name,
.dialogue-high-contrast .dialogue-choice__text { color: white; }
.dialogue-high-contrast .dialogue-choice { background-color: black; }
.dialogue-high-contrast .dialogue-choice--selected { background-color: rgb(40, 40, 40); }
.dialogue-reduced-motion .dialogue-box,
.dialogue-reduced-motion .dialogue-dim,
.dialogue-reduced-motion .dialogue-choice { transition-duration: 0s; }
.dialogue-reduced-motion .dialogue-choice--selected { translate: 0 0; }
