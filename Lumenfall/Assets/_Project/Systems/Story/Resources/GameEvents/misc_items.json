{
  "schemaVersion": 1,
  "quests": [],
  "dialogues": [
    {"id": "found_misc_worn_bandana", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Worn Bandana"}, {"key": "miscItem", "value": "worn_bandana"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Worn Bandana.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A yellow bandana with blue polka dots, scorched in a few small spots. Looks like someone's fire spell practice got a little out of hand. Holding it makes you want to stand up for what's right.", "nextNodeId": ""}]},
    {"id": "found_misc_rubber_ducky", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Rubber Ducky"}, {"key": "miscItem", "value": "rubber_ducky"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Rubber Ducky.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A squeaky yellow duck. It's been in more adventures than it looks.", "nextNodeId": ""}]},
    {"id": "found_misc_ticking_pocket_watch", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Ticking Pocket Watch"}, {"key": "miscItem", "value": "ticking_pocket_watch"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Ticking Pocket Watch.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "An old pocket watch with a ticking so loud it almost sounds like it's trying to talk. Strangely, you feel like you understand it. Winding it back makes you feel like you can give everyone a second chance.", "nextNodeId": ""}]},
    {"id": "found_misc_straw_hat", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Straw Hat"}, {"key": "miscItem", "value": "straw_hat"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Straw Hat.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A worn straw hat with a red ribbon. Despite numerous repairs and time taking its toll, it's clearly treasured. It smells faintly of sea salt and meat.", "nextNodeId": ""}]},
    {"id": "found_misc_picnic_basket", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Picnic Basket"}, {"key": "miscItem", "value": "picnic_basket"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Picnic Basket.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A checkered picnic basket, empty but well-loved. It gives you an idea: fill it with snacks and drinks and take your new friends out for a picnic.", "nextNodeId": ""}]},
    {"id": "found_misc_bouncy_plush", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Bouncy Plush"}, {"key": "miscItem", "value": "bouncy_plush"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Bouncy Plush.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A cheerful plush with a lopsided grin. A label on the back reads “property of the Spark Knight. DO NOT TOUCH.” Best leave it be.", "nextNodeId": ""}]},
    {"id": "found_misc_piece_of_parchment", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Piece of Parchment"}, {"key": "miscItem", "value": "piece_of_parchment"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Piece of Parchment.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A parchment with a delicate circle drawn in ink, with tiny corrections all over it and weird symbols. Whoever drew it seemed to take care and pride in their work.", "nextNodeId": ""}]},
    {"id": "found_misc_faded_polaroid", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Faded Polaroid"}, {"key": "miscItem", "value": "faded_polaroid"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Faded Polaroid.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "An old polaroid, badly faded. You can barely make out two people on a snowy mountain, one of them grinning a lot more than the other. On the back, in smudged ink: “#...essed.”", "nextNodeId": ""}]},
    {"id": "found_misc_tree_modus_card", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Tree Modus Card"}, {"key": "miscItem", "value": "tree_modus_card"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Tree Modus Card.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "Items branch out alphabetically. Elegant, organised, and terrible if you're in a hurry.", "nextNodeId": ""}]},
    {"id": "found_misc_tea_set_for_three", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Tea Set for Three"}, {"key": "miscItem", "value": "tea_set_for_three"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Tea Set for Three.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "Three cups in red, blue and yellow, each a little chipped from years of use. A note lists favourite blends in three very different handwritings. It looks like the owners were friends once.", "nextNodeId": ""}]},
    {"id": "found_misc_good_witch_novel", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Good Witch Novel"}, {"key": "miscItem", "value": "good_witch_novel"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Good Witch Novel.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A well-worn fantasy book about a heroic witch, with sticky notes on every favourite page. The owner has definitely read it more than ten times.", "nextNodeId": ""}]},
    {"id": "found_misc_cold_cup_of_coffee", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Cold Cup of Coffee"}, {"key": "miscItem", "value": "cold_cup_of_coffee"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Cold Cup of Coffee.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "Half a cup of coffee, stone cold. A sticky note on the side says \"fix later\". It never got fixed.", "nextNodeId": ""}]},
    {"id": "found_misc_slightly_warm_pebble", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Slightly Warm Pebble"}, {"key": "miscItem", "value": "slightly_warm_pebble"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Slightly Warm Pebble.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A smooth grey pebble that stays faintly warm, as if it remembers being a star. It's just a pebble. Probably.", "nextNodeId": ""}]},
    {"id": "found_misc_annoying_dog_exe", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "annoying_dog.exe (corrupted)"}, {"key": "miscItem", "value": "annoying_dog_exe"}], "nodes": [{"id": "found", "speaker": "", "text": "Found annoying_dog.exe (corrupted).", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A scroll labelled annoying_dog.exe. Unrolled, it shows nothing but tiny paw prints. Somehow, it is still loading.", "nextNodeId": ""}]},
    {"id": "found_misc_mop_for_your_troubles", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Mop for Your Troubles"}, {"key": "miscItem", "value": "mop_for_your_troubles"}], "nodes": [{"id": "found", "speaker": "", "text": "Found a Mop for Your Troubles.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "A well-used mop. The janitor said it was \"for your troubles\". You're not sure which troubles they meant.", "nextNodeId": ""}]},
    {"id": "found_misc_egg", "startNodeId": "found", "metadata": [{"key": "itemName", "value": "Egg"}, {"key": "miscItem", "value": "egg"}], "nodes": [{"id": "found", "speaker": "", "text": "Got an Egg.", "nextNodeId": "description"}, {"id": "description", "speaker": "", "text": "An egg. It is just an egg. It is still warm, and you cannot quite remember who gave it to you.", "nextNodeId": ""}]}
  ],
